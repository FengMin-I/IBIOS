# IBIOS 配置文件
# 复制此文件为 ibios.yaml，仅用于覆盖非敏感配置（端口、白名单等）。
# 凭证一律通过环境变量提供（DASHSCOPE_API_KEY / DEEPSEEK_API_KEY），不得写进本文件。

ibios:
  providers:
    - name: dashscope
      api-key: ${DASHSCOPE_API_KEY:}
      model: qwen-plus
    # 内置 mock provider（无需 key，用于测试全链路）
    # - name: mock
    #   api-key: ""
    #   model: mock
